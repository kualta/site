---
import {
  FiAtSign,
  FiGithub,
  FiGlobe,
  FiMail,
  FiYoutube,
} from "react-icons/fi";
import { RiTwitterXLine } from "react-icons/ri";
import Icons from "./Icons.astro";

interface Props {
  platform: string;
  size?: number;
}

const { platform, size = 18 } = Astro.props;
---
{platform === "website" && <FiGlobe size={size} />}
{platform === "github" && <FiGithub size={size + 2} />}
{platform === "youtube" && <FiYoutube size={size} />}
{platform === "twitter" && <RiTwitterXLine size={size} />}
{platform === "farcaster" && <Icons name="farcaster" size={size + 2} />}
{platform === "bluesky" && <Icons name="bluesky" size={size + 4} />}
{platform === "ping" && <FiAtSign size={size + 1} />}
{platform === "email" && <FiMail size={size + 2} />}
