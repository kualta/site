---
import {
  BlueskyIcon,
  EthereumIcon,
  GithubIcon,
  type IconComponent,
  InstagramIcon,
  MailIcon,
  TiktokIcon,
  XLogoIcon,
  YoutubeIcon,
} from "./icons";

interface Props {
  platform: string;
  size?: number;
}

const { platform, size = 18 } = Astro.props;
const icons: Record<string, IconComponent> = {
  github: GithubIcon,
  youtube: YoutubeIcon,
  twitter: XLogoIcon,
  instagram: InstagramIcon,
  tiktok: TiktokIcon,
  bluesky: BlueskyIcon,
  email: MailIcon,
  ethereum: EthereumIcon,
};
const Icon = icons[platform];
---
{Icon && <Icon size={size} />}
