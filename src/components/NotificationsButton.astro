---
import { BellIcon } from "@/components/icons";
const hide = ["/join", "/contacts", "/links", "/socials"].includes(Astro.url.pathname.replace(/\/$/, ""));
---
{!hide && (
  <div class="newsletter-dock">
    <a href="/links" class="newsletter-toggle" aria-label="Subscribe to newsletter">
      <BellIcon size={22} aria-hidden="true" />
    </a>
  </div>
)}
