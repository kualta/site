---
import { buttonVariants } from "@flow-industries/ui/components/button";
import type { Contact } from "@/types";
import ContactIcon from "./ContactIcon.astro";
import IconTooltip from "./IconTooltip.astro";

interface Props {
  contacts: Contact[];
  size?: number;
}

const { contacts, size = 18 } = Astro.props;
const linkClass = buttonVariants({
  variant: "ghost",
  size: "icon",
  className: "text-muted-foreground hover:text-foreground",
});
---
{
  contacts.map((contact) => (
    <IconTooltip label={contact.platform}>
      <a
        class={linkClass}
        href={contact.link}
        target="_blank"
        rel="noreferrer noopener"
        aria-label={contact.platform}
      >
        <ContactIcon platform={contact.platform} size={size} />
      </a>
    </IconTooltip>
  ))
}
