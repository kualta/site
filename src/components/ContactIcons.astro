---
import type { Contact } from "@/types";
import ContactIcon from "./ContactIcon.astro";

interface Props {
  contacts: Contact[];
  size?: number;
}

const { contacts, size = 20 } = Astro.props;
---
{
  contacts.map((contact) => (
    <div class="hover:scale-125 transition-all duration-100">
      <a
        href={contact.link}
        target="_blank"
        rel="noreferrer noopener"
        aria-label={contact.platform}
      >
        <ContactIcon platform={contact.platform} size={size} />
      </a>
    </div>
  ))
}
