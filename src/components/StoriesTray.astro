---
import BlueskyLogin from "@/components/BlueskyLogin";
import StoryAvatar from "@/components/StoryAvatar.astro";
import type { Story, VideoChannel } from "@/lib/videos";
import identity from "../../atproto.config.json";
import "@/styles/stories.css";

interface Props {
  /** The stories still up, which everyone sees. */
  live: Story[];
  channel: VideoChannel;
}

const { live, channel } = Astro.props;
---
<section
  class="stories"
  data-stories-tray
  data-owner={identity.did}
  data-author-name={channel.name}
  data-author-avatar={channel.avatar}
  aria-label="Stories"
>
  <ol class="stories-tray" data-stories-list>
    <li hidden={!live.length}>
      <StoryAvatar author={{ name: channel.name, avatar: channel.avatar }} stories={live} label={channel.name} />
    </li>
  </ol>
  <div class="stories-account">
    <BlueskyLogin client:idle compact />
  </div>
</section>

<script>
  import { mountOnEachPage } from "@/scripts/page-mount";
  import { mountStoryHistory } from "@/scripts/stories-history";

  mountOnEachPage("[data-stories-tray]", mountStoryHistory);
</script>
