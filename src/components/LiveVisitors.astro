---
// How many people have the site open right now, shown only once there is
// someone besides you. Sits beside the name in the header.
---
<div class="live-visitors" data-live-visitors transition:persist="live-visitors">
  <span
    class="live-visitors-count -m-0.5 rounded-sm border-2 border-transparent font-mono text-xs text-muted-foreground tabular-nums outline-none focus-visible:border-focus"
    tabindex="0"
    aria-describedby="live-visitors-tooltip"
  >
    <span class="live-visitors-dot" aria-hidden="true"></span>
    <span data-live-visitors-count></span>
  </span>
  <span
    id="live-visitors-tooltip"
    role="tooltip"
    class="live-visitors-tooltip rounded-md bg-foreground px-3 py-1.5 text-xs whitespace-nowrap text-background"
    data-live-visitors-tooltip
  ></span>
</div>

<style>
  /* takes no room in the header until there is someone to count */
  .live-visitors {
    position: relative;
    display: none;
  }

  .live-visitors[data-shown] {
    display: flex;
  }

  .live-visitors-count {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding-inline: 0.25rem;
    min-height: 1.75rem;
    cursor: help;
  }

  /* the one live thing in the frame, so it takes the brand's pink */
  .live-visitors-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    corner-shape: round;
    background: var(--color-pink);
  }

  .live-visitors-tooltip {
    position: absolute;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-start: 0;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 120ms var(--ease-out),
      visibility 120ms;
  }

  .live-visitors[data-shown] .live-visitors-count:is(:hover, :focus-visible) + .live-visitors-tooltip {
    visibility: visible;
    opacity: 1;
  }

  @media (pointer: coarse) {
    .live-visitors-count {
      min-height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-visitors-tooltip {
      transition: none;
    }
  }
</style>

<script>
  const PATH = "/api/visitors";
  const PING_MS = 30_000;
  /** two missed pongs means the line is dead even if the browser has not noticed */
  const SILENT_MS = 75_000;
  /** a quick switch to another tab should not count as leaving */
  const AWAY_MS = 30_000;

  let socket: WebSocket | undefined;
  let count = 0;
  let pinger: ReturnType<typeof setInterval> | undefined;
  let away: ReturnType<typeof setTimeout> | undefined;
  let retry: ReturnType<typeof setTimeout> | undefined;
  let failures = 0;

  // shared by every tab, so one person with three tabs open still counts once
  let fallbackId: string | undefined;
  function visitorId(): string {
    try {
      let id = localStorage.getItem("live-visitor");
      if (!id) {
        id = crypto.randomUUID();
        localStorage.setItem("live-visitor", id);
      }
      return id;
    } catch {
      fallbackId ??= crypto.randomUUID();
      return fallbackId;
    }
  }

  function render() {
    const badge = document.querySelector<HTMLElement>("[data-live-visitors]");
    if (!badge) return;
    badge.toggleAttribute("data-shown", count > 1);
    const number = badge.querySelector("[data-live-visitors-count]");
    const tooltip = badge.querySelector("[data-live-visitors-tooltip]");
    if (number) number.textContent = String(count);
    if (tooltip) tooltip.textContent = count > 1 ? `${count} people on the site right now` : "";
  }

  function settle(next: number) {
    count = next;
    render();
  }

  function drop() {
    const current = socket;
    socket = undefined;
    clearInterval(pinger);
    if (current) {
      current.onclose = current.onmessage = current.onerror = null;
      try {
        current.close(1000);
      } catch {}
    }
    settle(0);
  }

  function connect() {
    clearTimeout(retry);
    if (socket || document.visibilityState !== "visible") return;
    const url = new URL(PATH, location.href);
    url.protocol = url.protocol === "https:" ? "wss:" : "ws:";
    url.searchParams.set("id", visitorId());

    const current = new WebSocket(url);
    socket = current;
    let heard = Date.now();
    current.onopen = () => {
      failures = 0;
      heard = Date.now();
      pinger = setInterval(() => {
        if (Date.now() - heard > SILENT_MS) return reconnect();
        current.send("ping");
      }, PING_MS);
    };
    current.onmessage = (event) => {
      heard = Date.now();
      const next = Number(event.data);
      if (Number.isInteger(next) && next >= 0) settle(next);
    };
    current.onclose = () => reconnect();
  }

  function reconnect() {
    drop();
    if (document.visibilityState !== "visible") return;
    // spread out, so a deploy that drops everyone does not bring them all back at once
    const delay = Math.min(60_000, 2_000 * 2 ** failures++) * (0.5 + Math.random());
    retry = setTimeout(connect, delay);
  }

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") {
      clearTimeout(away);
      connect();
    } else {
      clearTimeout(retry);
      away = setTimeout(drop, AWAY_MS);
    }
  });
  // an open socket keeps the page out of the back-forward cache
  window.addEventListener("pagehide", drop);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) connect();
  });
  window.addEventListener("online", connect);
  document.addEventListener("astro:page-load", render);

  connect();
</script>
