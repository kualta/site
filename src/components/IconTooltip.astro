---
interface Props {
  label: string;
}

const { label } = Astro.props;
---
<span class="tooltip-host relative inline-flex items-center justify-center">
  <slot />
  <!-- links carry the same words in their aria-label, so this is decoration
       for the eye only and stays out of the accessibility tree -->
  <span
    class="tooltip-bubble rounded-md bg-foreground px-3 py-1.5 text-xs font-normal whitespace-nowrap text-background"
    aria-hidden="true"
  >
    {label}
  </span>
</span>

<style>
  .tooltip-bubble {
    position: absolute;
    inset-block-end: calc(100% + 0.5rem);
    inset-inline-start: 50%;
    z-index: 20;
    transform: translateX(-50%) translateY(2px);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 120ms var(--ease-out),
      transform 120ms var(--ease-out),
      visibility 120ms;
  }

  .tooltip-host:hover .tooltip-bubble,
  .tooltip-host:focus-within .tooltip-bubble {
    visibility: visible;
    opacity: 1;
    transform: translateX(-50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .tooltip-bubble {
      transition: none;
    }
  }
</style>
