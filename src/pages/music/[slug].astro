---
/**
 * One prerendered page per record, so a shared link unfurls with that record's
 * own artwork and title. The shelf itself is the same island either way — it is
 * simply handed the record this page was built for.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Track } from "@/types";
import musicData from "@/data/music.json";
import { SITE_URL } from "@/lib/seo";

export async function getStaticPaths() {
  const tracks = [...(musicData as Track[])].sort((a, b) => b.date.localeCompare(a.date));
  return tracks.map((track) => ({ params: { slug: track.slug }, props: { track, tracks } }));
}

interface Props {
  track: Track;
  tracks: Track[];
}

const { track } = Astro.props;

const kind = track.kind === "cover" ? "a cover" : "an original";
const description = `${track.title}, ${kind} by ${track.artist}`;

/** ISO 8601 duration, the only form schema.org reads */
const isoDuration = (seconds: number) =>
  `PT${Math.floor(seconds / 60)}M${String(Math.round(seconds % 60)).padStart(2, "0")}S`;

const url = `${SITE_URL}/music/${track.slug}/`;

const schema = [
  {
    "@type": "MusicRecording",
    "@id": `${url}#recording`,
    name: track.title,
    url,
    byArtist: { "@type": "MusicGroup", name: track.artist },
    ...(track.album ? { inAlbum: { "@type": "MusicAlbum", name: track.album } } : {}),
    ...(track.duration ? { duration: isoDuration(track.duration) } : {}),
    ...(track.track ? { position: track.track } : {}),
    datePublished: track.date,
    audio: {
      "@type": "AudioObject",
      contentUrl: `${SITE_URL}${track.src}`,
      encodingFormat: "audio/mpeg",
      ...(track.duration ? { duration: isoDuration(track.duration) } : {}),
    },
    ...(track.originalArtist
      ? { recordingOf: { "@type": "MusicComposition", name: track.title, composer: { "@type": "Person", name: track.originalArtist } } }
      : {}),
  },
];
---
<BaseLayout
  title={track.title}
  description={description}
  exactDescription
  image={track.og ?? "/opengraph-image.png"}
  imageAlt={`${track.title} by ${track.artist}`}
  schema={schema}
>
  <h1 class="sr-only">{track.title} by {track.artist}</h1>
</BaseLayout>
