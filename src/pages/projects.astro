---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import type { Project } from "@/types";
import projectsData from "@/data/projects.json";
import { SITE_URL } from "@/lib/seo";

const projects = [...(projectsData as Project[])]
  .sort((a, b) => (b.relevance || 0) - (a.relevance || 0))
  .sort((a, b) => (a.status === "complete" ? -1 : 1))
  .sort((a, b) => (a.status === "ongoing" ? -1 : 1));

const schema = [
  {
    "@type": "ItemList",
    "@id": `${SITE_URL}/projects/#list`,
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "SoftwareSourceCode",
        name: project.full_name || project.name,
        description: project.description,
        ...(project.link ? { url: project.link } : {}),
        ...(project.git_link ? { codeRepository: project.git_link } : {}),
        ...(project.language ? { programmingLanguage: project.language } : {}),
        author: { "@id": `${SITE_URL}/#person` },
      },
    })),
  },
];
---
<BaseLayout
  title="projects"
  description="Things kualta has built and is building: open source libraries, apps and experiments, most of them with the source in the open."
  schema={schema}
>
  <div class="max-w-xl w-full place-items-center justify-center mb-10">
    <h1 class="sr-only">projects</h1>
    <div class="flex flex-col w-full gap-2 p-4">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</BaseLayout>
