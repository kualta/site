---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ProjectList } from "@/components/ProjectList.tsx";
import type { Project } from "@/types";
import projectsData from "@/data/projects.json";
import { SITE_URL } from "@/lib/seo";

const projects = [...(projectsData as Project[])]
  .sort((a, b) => (b.relevance || 0) - (a.relevance || 0))
  .sort((a, b) => (a.status === "complete" ? -1 : 1))
  .sort((a, b) => (a.status === "ongoing" ? -1 : 1));

const latest = [...(projectsData as Project[])]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3)
  .map((project) => project.full_name || project.name)
  .join(", ");

const schema = [
  {
    "@type": "ItemList",
    "@id": `${SITE_URL}/projects#list`,
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "SoftwareSourceCode",
        name: project.full_name || project.name,
        description: project.description,
        ...(project.link ? { url: project.link } : {}),
        ...(project.git_link ? { codeRepository: project.git_link } : {}),
        ...(project.language ? { programmingLanguage: project.language } : {}),
        author: { "@id": `${SITE_URL}/#person` },
      },
    })),
  },
];
---
<BaseLayout
  title="projects"
  description={`Projects by kualta. Latest: ${latest}`}
  schema={schema}
>
  <div class="mb-10 w-full max-w-xl px-4 pt-6">
    <h1 class="sr-only">projects</h1>
    <ProjectList client:visible projects={projects} />
  </div>
</BaseLayout>
