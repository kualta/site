---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactIcon from "@/components/ContactIcon.astro";
import type { Contact } from "@/types";
import contactsData from "@/data/contacts.json";
import { SITE_URL } from "@/lib/seo";

const contacts = [...(contactsData as Contact[])].sort(
  (a, b) => (a.platform.length + a.label.length) - (b.platform.length + b.label.length),
);

const schema = [
  {
    "@type": "ContactPage",
    "@id": `${SITE_URL}/contacts/#contact`,
    mainEntity: { "@id": `${SITE_URL}/#person` },
  },
];
---
<BaseLayout
  title="contacts"
  description="Contact kualta"
  schema={schema}
  canonicalPath="/contacts/"
>
  <div class="max-w-xl w-full grow flex flex-col gap-2 p-4">
    <h1 class="sr-only">contacts</h1>
    {contacts.map((contact) => (
      <div
        class="flex w-full min-w-0 flex-row items-baseline gap-2 rounded-xl bg-secondary px-4 py-2 text-lg
               drop-shadow-sm dark:bg-dark-secondary"
      >
        <a
          href={contact.link}
          target="_blank"
          rel="noopener noreferrer me"
          class="flex flex-row items-baseline gap-2 min-w-0 flex-grow hover:opacity-70"
        >
          <span class="font-medium whitespace-nowrap">{contact.platform}</span>
          <span class="min-w-0 truncate text-sm text-secondary-text">{contact.label}</span>
          <span class="ml-auto w-5 shrink-0 flex justify-center text-secondary-text" aria-hidden="true">
            <ContactIcon platform={contact.platform} size={16} />
          </span>
        </a>
      </div>
    ))}
  </div>
</BaseLayout>
