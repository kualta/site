---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactIcon from "@/components/ContactIcon.astro";
import type { Contact } from "@/types";
import contactsData from "@/data/contacts.json";
import { SITE_URL } from "@/lib/seo";

const contacts = [...(contactsData as Contact[])].sort(
  (a, b) => (a.platform.length + a.label.length) - (b.platform.length + b.label.length),
);

const schema = [
  {
    "@type": "ContactPage",
    "@id": `${SITE_URL}/contacts#contact`,
    mainEntity: { "@id": `${SITE_URL}/#person` },
  },
];
---
<BaseLayout
  title="contacts"
  description="Contact kualta"
  schema={schema}
  canonicalPath="/contacts"
>
  <h1 class="sr-only">contacts</h1>
  <!-- the cards share one grid through subgrid, so every handle starts on the same line -->
  <div class="max-w-xl w-full grow content-start grid grid-cols-[minmax(0,1fr)_auto_auto] gap-x-2 gap-y-2 p-4">
    {contacts.map((contact) => (
      <div
        class="col-span-full grid grid-cols-subgrid rounded-xl bg-secondary px-4 py-2 text-lg drop-shadow-sm
               dark:bg-dark-secondary"
      >
        <a
          href={contact.link}
          target="_blank"
          rel="noopener noreferrer me"
          class="col-span-full grid grid-cols-subgrid items-center hover:opacity-70"
        >
          <span class="font-medium whitespace-nowrap">{contact.platform}</span>
          <span class="truncate text-sm text-secondary-text">{contact.label}</span>
          <span class="w-5 flex justify-center text-secondary-text" aria-hidden="true">
            <ContactIcon platform={contact.platform} size={18} />
          </span>
        </a>
      </div>
    ))}
  </div>
</BaseLayout>
