---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactIcon from "@/components/ContactIcon.astro";
import type { Contact } from "@/types";
import contactsData from "@/data/contacts.json";
import { SITE_URL } from "@/lib/seo";
import { loadBlueskyProfile } from "@/lib/bluesky/profile";

const profile = await loadBlueskyProfile();
const contacts = [...(contactsData as Contact[])].sort(
  (a, b) => (a.platform.length + a.label.length) - (b.platform.length + b.label.length),
);

const schema = [
  {
    "@type": "ContactPage",
    "@id": `${SITE_URL}/contacts#contact`,
    mainEntity: { "@id": `${SITE_URL}/#person` },
  },
];
---
<BaseLayout
  title="contacts"
  description="Contact kualta"
  schema={schema}
  canonicalPath="/contacts"
>
  <h1 class="sr-only">contacts</h1>
  <div class="flex w-full max-w-xl flex-col items-center p-4">
    {profile.avatar && (
      <img
        src={profile.avatar}
        alt="kualta"
        width="96"
        height="96"
        class="h-24 w-24 rounded-full object-cover drop-shadow-sm"
      />
    )}
    {profile.description && (
      <p class="mt-3 whitespace-pre-line text-center text-sm text-secondary-text">{profile.description}</p>
    )}
    <div class="mt-10 flex w-full max-w-[16rem] flex-col gap-2">
      {contacts.map((contact) => (
        <a
          href={contact.link}
          target="_blank"
          rel="noopener noreferrer me"
          class="flex items-center gap-3 rounded-xl bg-secondary px-4 py-2 text-lg drop-shadow-sm
                 dark:bg-dark-secondary [&:hover>*]:opacity-70"
        >
          <span class="w-5 flex shrink-0 justify-center text-secondary-text" aria-hidden="true">
            <ContactIcon platform={contact.platform} size={18} />
          </span>
          <!-- the line box centers on cap height, but the names are lowercase, so the
               x-height they are mostly made of sits 2px low until lifted -->
          <span class="-translate-y-0.5 font-medium">{contact.platform}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
