---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getPostsMetadata } from "@/lib/posts";
import { SITE_URL } from "@/lib/seo";

export async function getStaticPaths() {
  const posts = await getPostsMetadata();
  const tags = [...new Set(posts.flatMap((post) => post.tags))];
  return tags.map((tag) => ({ params: { slug: tag } }));
}

const { slug } = Astro.params;
const filter = slug as string;
const postsForTag = (await getPostsMetadata()).filter(
  (post) => post.tags.indexOf(filter) !== -1,
);
const tagText = filter.replace("-", " ").toLowerCase();

const titles = postsForTag.map((post) => post.title).join(", ");
const description = `Every post tagged ${tagText} on kualta's blog: ${titles}. Long-form essays on philosophy, crypto, culture and game design.`;

const schema = [
  {
    "@type": "ItemList",
    "@id": `${SITE_URL}/posts/tags/${filter}/#list`,
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: postsForTag.length,
    itemListElement: postsForTag.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${SITE_URL}/posts/${post.filename}/`,
      name: post.title,
    })),
  },
];
---
<BaseLayout title={`tag: ${tagText}`} description={description} schema={schema}>
  <div class="max-w-2xl min-h-[47rem]">
    <div class="flex flex-col h-full place-items-center justify-center gap-4 mb-20">
      <h1 class="sr-only">posts tagged {tagText}</h1>
      <div class="flex place-content-center justify-center flex-row flex-wrap p-4">
        <a href="/posts/" aria-label={`all posts, currently filtered by ${tagText}`}>
          <span class="select-none">•</span>
          <span class="px-4">{tagText}</span>
          <span class="select-none">•</span>
        </a>
      </div>
      {postsForTag.map((post) => <PostCard {...post} />)}
    </div>
  </div>
</BaseLayout>
