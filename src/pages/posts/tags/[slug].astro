---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PostList } from "@/components/PostList.tsx";
import { getPostsMetadata } from "@/lib/posts";
import { SITE_URL } from "@/lib/seo";

export async function getStaticPaths() {
  const posts = await getPostsMetadata();
  const tags = [...new Set(posts.flatMap((post) => post.tags))];
  return tags.map((tag) => ({ params: { slug: tag } }));
}

const { slug } = Astro.params;
const filter = slug as string;
const postsForTag = (await getPostsMetadata()).filter(
  (post) => post.tags.indexOf(filter) !== -1,
);
const tagText = filter.replace("-", " ").toLowerCase();

const description = `Essays by kualta tagged ${tagText}`;

const schema = [
  {
    "@type": "ItemList",
    "@id": `${SITE_URL}/posts/tags/${filter}#list`,
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: postsForTag.length,
    itemListElement: postsForTag.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${SITE_URL}/posts/${post.filename}`,
      name: post.title,
    })),
  },
];
---
<BaseLayout title={`tag: ${tagText}`} description={description} schema={schema}>
  <div class="mb-10 flex w-full max-w-xl grow flex-col gap-6 px-4 pt-6">
    <h1 class="flex items-center gap-2 text-sm font-[550] tracking-wide text-muted-foreground">
      <a href="/posts" class="hover:text-foreground" aria-label="all posts">posts</a>
      <span aria-hidden="true">/</span>
      <span class="text-foreground">{tagText}</span>
    </h1>
    <PostList posts={postsForTag} />
  </div>
</BaseLayout>
