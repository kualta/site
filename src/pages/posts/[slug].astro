---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubscriptionBox from "@/components/SubscriptionBox.astro";
import TableOfContents from "@/components/TableOfContents.tsx";
import { getPosts, getPostContent } from "@/lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;
const post = await getPostContent(slug as string);

if (!post) {
  return Astro.redirect("/404");
}

const { Content, headings } = post;
---
<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  image={post.data.preview}
  imageAlt={post.data.title}
  type="article"
  article={{
    publishedTime: post.data.publishedTime,
    modifiedTime: post.data.modifiedTime,
    tags: post.data.tags,
    section: post.data.tags?.[0],
    wordCount: post.data.wordCount,
  }}
>
  <div class="max-w-2xl w-full relative mb-10">
    <TableOfContents headings={headings} client:idle />
    <article
      class="z-[10] max-w-2xl rounded-xl p-2 py-8 prose dark:prose-invert dark:prose-blockquote:border-dark-primary prose-img:rounded-xl"
    >
      <h1 class="mb-2 text-center">{post.data.title}</h1>
      <p class="post-subtitle mb-6 mt-0 text-center">{post.data.description}</p>
      <Content />
      {post.data.tags.length > 0 && (
        <nav aria-label="Tags" class="not-prose flex flex-row flex-wrap gap-3 pt-10 text-sm text-secondary-text">
          {post.data.tags.map((tag) => (
            <a href={`/posts/tags/${tag}/`} class="hover:opacity-70" rel="tag">#{tag}</a>
          ))}
        </nav>
      )}
    </article>
    <SubscriptionBox />
  </div>
</BaseLayout>
