---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PostList } from "@/components/PostList.tsx";
import { getPostsMetadata } from "@/lib/posts";
import { SITE_URL } from "@/lib/seo";

const posts = await getPostsMetadata();

// the index is a list of articles, and saying so is what lets it show up as one
const schema = [
  {
    "@type": "ItemList",
    "@id": `${SITE_URL}/posts#list`,
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${SITE_URL}/posts/${post.filename}`,
      name: post.title,
    })),
  },
];
---
<BaseLayout
  title="posts"
  description={`Essays by kualta. Latest: ${posts[0].title}`}
  schema={schema}
>
  <div class="mb-10 flex w-full max-w-xl grow flex-col px-4 pt-6">
    <h1 class="sr-only">posts</h1>
    <PostList posts={posts} />
  </div>
</BaseLayout>
