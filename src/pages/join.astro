---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Sticker from "@/components/Sticker.astro";
import { EmailSubscription } from "@/components/EmailSubscription.tsx";
---
<BaseLayout
  title="join"
  description="Subscribe to kualta's essays"
>
  <div class="flex flex-col gap-4 w-full max-w-xl px-6">
    <div class="flex flex-col gap-4 py-10 px-4 sm:px-12 mb-32 relative">
      <h1 class="text-center text-4xl font-medium tracking-tighter">Subscribe</h1>
      <p class="-mt-2 mb-2 text-center text-lg text-muted-foreground">Essays by email</p>
      <EmailSubscription client:load />
      <Sticker
        name="kurier"
        class="hidden sm:flex absolute w-32 h-32 md:w-48 md:h-48 -right-10 -bottom-10 md:-right-24 md:-bottom-24"
      />
    </div>
  </div>
</BaseLayout>
