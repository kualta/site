---
import BaseLayout from "@/layouts/BaseLayout.astro";

const endpoints = [
  "/api/contacts.json",
  "/api/posts.json",
  "/api/projects.json",
  "/api/subscribe",
];
---
<BaseLayout
  title="api"
  description="The public JSON endpoints behind this site."
  noindex
>
  <div class="mx-auto max-w-2xl">
    <h1 class="sr-only">api</h1>
    <ul class="gap-2 text-sm sm:text-base flex-col flex ml-4">
      {endpoints.map((endpoint) => (
        <li class="font-mono">
          <a href={endpoint}>{endpoint}</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
