---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactIcons from "@/components/ContactIcons.astro";
import ActivityWidget from "@/components/activity/ActivityWidget.astro";
import { FiChevronDown, FiChevronUp } from "react-icons/fi";
import type { Contact } from "@/types";
import contactsData from "@/data/contacts.json";
import { TAGLINE } from "@/lib/seo";

// rendered per request so the middleware can send www and kualta.com to the
// canonical apex; every other route is prerendered
export const prerender = false;

const contacts = (contactsData as Contact[])
  .filter((c) => c.is_main)
  .reverse();

const month = new Date().getMonth();
const isChristmas = month >= 10;
Astro.response.headers.set("cache-control", "no-store");
---
<BaseLayout description={TAGLINE}>
  <div class="snowflake flex w-full grow flex-col">
    <!-- 6rem is the header above main, so the name gets the first screen exactly.
         scroll-mt-24 cancels that offset again for snapping: without it the first
         screen's resting place would be a header's height down the page -->
    <section
      class="flex min-h-[calc(100dvh-6rem)] w-full scroll-mt-24 flex-col items-center px-4 pb-8"
      data-activity-screen
    >
      <div class="flex grow flex-col items-center justify-center">
        <div class="flex w-min flex-col gap-2 font-bold">
          <h1 class="relative text-left text-8xl text-balance">
            kualta
            {isChristmas && (
              <img
                src="/santa_hat.svg"
                class="absolute top-1 -left-1 size-6"
                alt="santa hat"
                width="277"
                height="233"
                decoding="async"
              />
            )}
          </h1>
          <div class="flex flex-row items-center gap-3">
            <ContactIcons contacts={contacts} />
          </div>
        </div>
      </div>

      <a
        href="#activity"
        data-home-activity-pending
        class="home-activity-link flex min-h-[42px] shrink-0 flex-col items-center gap-2 text-xs text-secondary-text
               hover:opacity-70"
      >
        <time class="tabular-nums" data-activity-last-seen hidden />
        <FiChevronDown className="animate-bounce motion-reduce:animate-none" size={18} aria-hidden="true" />
        <span class="sr-only">Jump to recent activity</span>
      </a>
    </section>

    <section
      id="activity"
      class="mx-auto w-full max-w-[min(92vw,42rem)] px-4 pt-8 pb-16"
      aria-label="Kualta's recent activity"
      data-activity-screen
    >
      <ActivityWidget />
    </section>
  </div>

  <button type="button" class="feed-back-top" aria-label="Go back up">
    <FiChevronUp size={18} aria-hidden="true" />
    <span class="feed-back-top-tooltip" aria-hidden="true">go back up</span>
  </button>

  <script>
    import { holdFirstScreen } from "@/scripts/first-screen-scroll";

    document.addEventListener("astro:page-load", () => {
      const feed = document.getElementById("activity");
      if (feed) {
        const release = holdFirstScreen(feed);
        document.addEventListener("astro:before-swap", release, { once: true });
      }

      const button = document.querySelector<HTMLButtonElement>(".feed-back-top");
      if (!button) return;
      button.addEventListener("click", () => {
        window.scrollTo({
          top: 0,
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
        });
        document.querySelector<HTMLAnchorElement>(".site-header a")?.focus({ preventScroll: true });
      });
    });
  </script>

  <style is:global>
    .home-activity-link {
      transition: opacity 350ms ease;
    }

    .home-activity-link[data-home-activity-pending] {
      opacity: 0;
      visibility: hidden;
    }

    @media (prefers-reduced-motion: reduce) {
      .home-activity-link {
        transition: none;
      }
    }

    /* the two screens are the only places the page comes to rest, so one scroll
       down carries the whole way to the feed; the feed is taller than the
       viewport, which leaves reading through it unsnapped */
    html:has([data-activity-screen]) {
      scroll-snap-type: y mandatory;
    }

    [data-activity-screen] {
      scroll-snap-align: start;
    }

    /* until the first rows arrive there is only a skeleton below, so the feed
       takes no room and the page is one screen with nothing to scroll to; the
       link above drops its pending mark once activity loads, which lets it in.
       The collapsed feed is no resting place either, or the page snaps down to
       it the moment it grows */
    html:has([data-home-activity-pending]) #activity {
      height: 0;
      padding-block: 0;
      overflow: hidden;
      scroll-snap-align: none;
    }

  </style>
</BaseLayout>
