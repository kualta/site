---
import ActivityRows from "@/components/activity/ActivityRows.astro";
import { decodeActivityCursor } from "@/lib/activity";
import { getSharedActivityFeed, getSharedActivityHistory } from "@/lib/activity/shared";
import { env } from "cloudflare:workers";

// serves both halves of the feed's paging: the newest rows for the live poll,
// and older pages as the reader scrolls past what the page shipped with
export const prerender = false;
export const partial = true;

const ROW_LIMIT = 20;
const before = Astro.url.searchParams.get("before");

// Both paths read shared data only; the scheduled Worker keeps it warm.
const feed = before
  ? null
  : await getSharedActivityFeed(env, true);
const page = feed ?? (await getSharedActivityHistory(env, before!));

const from = decodeActivityCursor(before);
const boundarySeen = Boolean(
  from && page.completeSince && Date.parse(from.occurredAt) < Date.parse(page.completeSince),
);

Astro.response.headers.set("cache-control", "no-store");
---
{
  feed && (
    <span
      hidden
      data-activity-meta
      data-server-now={new Date().toISOString()}
      data-last-seen={feed.lastSeenAt ?? undefined}
      data-trusted-until={feed.trustedUntil ?? undefined}
      data-fresh-until={feed.freshUntil ?? undefined}
      data-delayed={feed.delayed ? "true" : "false"}
    />
  )
}
<ActivityRows
  events={page.events}
  completeSince={page.completeSince}
  limitedBy={page.coverageLimitedBy}
  boundarySeen={boundarySeen}
  limit={ROW_LIMIT}
/>
